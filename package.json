{
  "name": "grudge-ledger",
  "private": true,
  "version": "1.0.0",
  "description": "Shared grudge ledgers with cobweb avatars, passive-aggressive apology receipts, and weekly share-or-burn reports.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.8"
  }
}